LLM_API_KEY=""
LLM_MODEL="ollama/gemma4:31b-cloud"
# ":cloud" models require an Ollama subscription; use the locally-pulled model instead.
# ollama_chat/ (not ollama/) routes to Ollama's /api/chat endpoint, which supports native
# tool calling. With the plain ollama/ prefix the tools param is dropped and the model
# returns tool_calls=null (the agent narrates instead of acting — empty migration output).
# LLM_MODEL="ollama_chat/gemma4:31b-cloud"
LLM_BASE_URL="http://host.docker.internal:11434"
OPENHANDS_SUPPRESS_BANNER=1

USE_SUBAGENTS=1

# Optional: Context window size (num_ctx) for Ollama models
# Default: 32768 if not set
# 131072 is far larger than needed: the orchestrator and subagents now condense history
# (~20 events), so each turn's prompt stays small. A smaller window means a smaller KV
# cache (faster/cheaper per turn) without truncating real context.
# Common values: 8192, 16384, 32768, 65536, 131072
LLM_NUM_CTX=65536

# Base host port for the Docker workspace (server at this port, VSCode at +1, VNC at +2).
# Override per-run with --port. Change this to avoid colliding with another running migration.
DOCKER_PORT_BASE=6969

CHROME_FOR_TESTING_VERSION="131.0.6778.108"

# Optional: Keep-alive duration for Ollama models
# Default: 30m
# Controls how long the model stays loaded in memory after the last request
# Format: duration string like "5m", "30m", "1h", or "-1" for indefinite
LLM_KEEP_ALIVE=4m

LLM_INPUT_COST_PER_TOKEN=0.00000013
LLM_OUTPUT_COST_PER_TOKEN=0.00000013


LLM_TEMPERATURE=0.5

# Use the model's native (API-level) tool calling instead of prompt-based XML tool calling.
# Native is much cheaper/faster: no per-turn tool-schema re-send, far fewer turns.
# Requires the ollama_chat/ model prefix (see LLM_MODEL above) — with plain ollama/ the
# tools param is dropped and the agent writes nothing.
LLM_NATIVE_TOOL_CALLING=true

# Cross-run memory: memory/MEMORY.md is uploaded into each run as /workspace/MEMORY.md;
# the agent reads it first and folds generalizable learnings back in after the run.
# MEMORY_READONLY=1 turns it into a fixed knowledge base (updates never collected).
# Updates over MEMORY_MAX_CHARS are discarded entirely, so the file cannot grow unboundedly.
# MEMORY_GIT_COMMIT=1 auto-commits the file after each run/batch (push stays manual).
MEMORY=1
MEMORY_READONLY=0
MEMORY_MAX_CHARS=10000
MEMORY_GIT_COMMIT=0
