{
  "name": "agentic-migrator-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript/pi rewrite of AgenticMigrator (MV2->MV3 Chrome extension migrator)",
  "bin": {
    "migrate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "clean": "rm -rf run/*",
    "transcript": "tsx scripts/view-transcript.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.3",
    "better-sqlite3": "^13.0.3",
    "extlens-sdk": "file:../extlens/packages/host-sdk",
    "playwright": "^1.61.1",
    "secretspec": "^0.19.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "^4.23.0",
    "typescript": "5.7.2"
  }
}
