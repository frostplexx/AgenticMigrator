{
  "manifest_version": 2,
  "name": "Capybara Extension",
  "version": "1.0",
  "description": "A Capybara a day keeps the doctor away!",

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Capybara Facts",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },

  "content_scripts": [{
    "matches": ["http://*.lmu.de/*", "https://*.lmu.de/*"],
    "js": ["content.js"],
    "run_at": "document_end"
  }],

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "http://*.lmu.de/*",
    "https://*.lmu.de/*",
    "https://api.capy.lol/*",
    "<all_urls>"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}