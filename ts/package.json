    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.3",
    "playwright": "1.49.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
