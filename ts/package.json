{
  "name": "agentic-migrator-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript/pi rewrite of AgenticMigrator (MV2->MV3 Chrome extension migrator)",
  "bin": { "migrate": "dist/cli.js" },
