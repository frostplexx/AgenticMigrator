# LLM Configuration
# Required: The model identifier (e.g., "ollama/qwen2.5-coder:32b", "anthropic/claude-4", etc.)
LLM_MODEL=ollama/qwen2.5-coder:32b

# Required for non-Ollama providers: API key for the LLM service
LLM_API_KEY=your-api-key-here

# Required for Ollama: Base URL of your Ollama server
LLM_BASE_URL=http://localhost:11434

# Optional: Context window size (num_ctx) for Ollama models
# Default: 32768 if not set
# Increase this for longer conversations or larger codebases
# Common values: 8192, 16384, 32768, 65536, 131072
LLM_NUM_CTX=32768

# Optional: Keep-alive duration for Ollama models
# Default: 30m
# Controls how long the model stays loaded in memory after the last request
# Format: duration string like "5m", "30m", "1h", or "-1" for indefinite
LLM_KEEP_ALIVE=30m

# Optional: Cost tracking (per-token pricing)
# Set these to track API costs. Defaults to $0 for Ollama (local models).
# For API providers, set the cost per token (e.g., for GPT-4: input=0.00003, output=0.00006)
# LLM_INPUT_COST_PER_TOKEN=0.00003
# LLM_OUTPUT_COST_PER_TOKEN=0.00006

# Common pricing examples (as of 2024):
# GPT-4 Turbo: input=0.00001, output=0.00003
# GPT-4: input=0.00003, output=0.00006
# Claude 3.5 Sonnet: input=0.000003, output=0.000015
# Claude 3 Opus: input=0.000015, output=0.000075
