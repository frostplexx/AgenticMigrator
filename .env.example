# LLM Configuration
# Required: the model identifier for the migration container. Examples:
#   "ollama/gemma4:31b-cloud"   (default, local)
#   "saia/<model>"              (GWDG OpenAI-compatible backend)
LLM_MODEL=ollama/gemma4:31b-cloud

# Required for Ollama: base URL of the Ollama server.
# In the container, the default is http://host.docker.internal:11434
LLM_BASE_URL=http://localhost:11434

# Required for remote (non-Ollama) backends: the API key.
# If unset, the CLI resolves it automatically from secretspec (1Password backend).
# Run "secretspec set LLM_API_KEY" once to store it, or export this variable.
# LLM_API_KEY=your-api-key

# Optional: context window size (num_ctx) for the model.
# Default: 65536
LLM_NUM_CTX=65536

# Optional: maximum output tokens per request. Overrides the provider default.
# LLM_MAX_TOKENS=8192

# Optional: sampling thinking mode for the model.
# Default: off. Accepts "on" (high) or "off".
# LLM_THINKING=off

# Optional: number of retries for failed LLM requests.
# LLM_NUM_RETRIES=3

# Optional: maximum fix attempts during a migration.
# Default: 3
MAX_FIX_ATTEMPTS=3

# Migration run
# Optional: output root for runs. Default: ./run
# EXTENSION_DIR=
# OUT_DIR=./run
# PLAN_FILE=
# REPORT_FILE=

# Optional: Docker migration image tag. When unset the CLI computes a content-hash
# tag and builds the image if it is missing.
# MIGRATOR_IMAGE=agentic-migrator-ts:latest

# Optional: enable a headless VNC inside the migration container.
# Set to "1" to enable. Debug use only.
# ENABLE_VNC=0

# Optional: base port for the VNC proxy. Container listens on portBase:6080.
# Used only when ENABLE_VNC=1.
# DOCKER_PORT_BASE=6100

# extlens server
# Optional: port for the extlens WebSocket server. Default: 8081
# EXLENS_PORT=8081
# Optional: run directory the extlens server serves. Default: ./run
# EXLENS_RUN_DIR=./run
# Optional: source corpus the extlens server lists as unmigrated extensions.
# Accepts a corpus dir or a single extension dir. Also settable via --source-dir.
# EXLENS_SOURCE_DIR=./corpus

# Logging
# LOG_LEVEL=info
# LOG_FILE=

# Paths (container)
# SKILLS_DIR=
# EMC_DIR=
